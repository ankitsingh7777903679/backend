PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/coaching_saas?retryWrites=true&w=all

# Auth JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_key_change_in_production_123!
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_456!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxx

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=xxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxx

# Resend Email
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=noreply@yoursaas.com
